{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBook",
  "version": "0.1.0",
  "identifier": "com.mybook.desktop",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "我的书房",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
